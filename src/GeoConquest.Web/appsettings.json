{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "DatabaseName": "geoconquest"
  },
  "NpcPacing": {
    "NormalDelayMilliseconds": 1200,
    "FastForwardDelayMilliseconds": 200
  },
  "Groq": {
    "Model": "openai/gpt-oss-20b",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "MaxCompletionTokens": 400,
    "Temperature": 0.7,
    "ReasoningEffort": "low"
  },
  "Commentary": {
    "MaxRequestsPerMinute": 10,
    "TimeBudgetMilliseconds": 2500,
    "MinimumAiBudgetMilliseconds": 400
  }
}
