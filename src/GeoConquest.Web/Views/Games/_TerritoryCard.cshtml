@model TerritoryCardViewModel
@{
    var territory = Model.Territory;
    var owner = Model.Owner;
}
<li class="gc-card" data-card data-country="@territory.CountryCode" data-owner="@owner.Id" data-color="@owner.ColorKey"
    data-soldiers="@territory.Soldiers" data-yours="@(Model.IsYours ? "true" : "false")" data-target="false" data-dim="false"
    data-tilt="@Model.Tilt">
    <span class="gc-card__tab" aria-hidden="true">@territory.CountryCode</span>
    <div class="gc-card__stripe" aria-hidden="true"></div>
    <div class="gc-card__body">
        <div class="gc-card__title">
            <span class="gc-flag" aria-hidden="true">
                <span class="gc-flag__code">@territory.CountryCode</span>
                <img class="gc-flag__image" src="https://flagcdn.com/w40/@(territory.CountryCode.ToLowerInvariant()).png" width="32" height="24" loading="lazy" alt="" />
            </span>
            <h3 class="gc-card__name">@territory.CountryName</h3>
        </div>
        <p class="gc-card__owner">
            <span class="gc-player-badge" aria-hidden="true">
                <span class="gc-player-badge__initials" data-bind="owner-initials">@owner.Initials</span>
                <span class="gc-player-badge__pattern"></span>
            </span>
            <span data-bind="owner-label">@owner.Label(Model.ViewerIsOwner)</span>
        </p>
        <p class="gc-card__note" data-bind="card-note" hidden></p>
    </div>
    <div class="gc-card__stamp-zone">
        @if (Model.IsConquered)
        {
            <p class="gc-stamp" data-stamp>Conquered</p>
        }
        else
        {
            <p class="gc-stamp" data-stamp hidden>Conquered</p>
        }
    </div>
    <div class="gc-card__foot">
        <p class="gc-card__label">Soldiers</p>
        <span class="gc-counter" data-bind="soldiers">@territory.Soldiers</span>
    </div>
</li>
