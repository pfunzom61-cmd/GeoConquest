@using GeoConquest.Core.Enums
@model CampaignListViewModel
@{
    ViewData["Title"] = "My Campaigns";
}

<h1>My Campaigns</h1>

<p><a asp-action="New">Start a new campaign</a></p>

<form method="get" asp-action="Index" role="search">
    <label for="search">Search by country or name</label>
    <input id="search" name="search" type="search" value="@Model.Search" />

    <label for="status">Status</label>
    <select id="status" name="status">
        <option value="">All</option>
        @foreach (var status in Enum.GetValues<GameStatus>())
        {
            <option value="@status" selected="@(Model.Status == status)">@status</option>
        }
    </select>

    <label for="sort">Sort by</label>
    <select id="sort" name="sort">
        @foreach (var sort in Enum.GetValues<CampaignSort>())
        {
            <option value="@sort" selected="@(Model.Sort == sort)">@sort</option>
        }
    </select>

    <button type="submit">Apply</button>
</form>

@if (Model.Campaigns.Count == 0)
{
    <p>No campaigns found.</p>
}
else
{
    <table>
        <caption>Your campaigns</caption>
        <thead>
            <tr>
                <th scope="col">Country</th>
                <th scope="col">Status</th>
                <th scope="col">Round</th>
                <th scope="col">Countries held</th>
                <th scope="col">Last played</th>
                <th scope="col"><span class="visually-hidden">Open</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var campaign in Model.Campaigns)
            {
                <tr>
                    <th scope="row">@campaign.CountryName</th>
                    <td>@campaign.Status</td>
                    <td>@campaign.Round</td>
                    <td>@campaign.CountriesOwned of 10</td>
                    <td>@campaign.LastPlayed.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a asp-action="Play" asp-route-id="@campaign.GameId">
                            @(campaign.Status == nameof(GameStatus.InProgress) ? "Resume" : "View")
                            <span class="visually-hidden">@campaign.CountryName campaign</span>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
