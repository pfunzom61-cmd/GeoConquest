@using GeoConquest.Core.Enums
@model CampaignListViewModel
@{
    ViewData["Title"] = "My campaigns";
    var isFiltered = !string.IsNullOrWhiteSpace(Model.Search) || Model.Status is not null;
}

<div class="gc-page-head">
    <h1 class="gc-heading gc-heading--title gc-page-head__title">My campaigns</h1>
    <div class="gc-page-head__tools">
        <a class="gc-button gc-button--light" asp-action="New">Start a new campaign</a>
    </div>
</div>

<form class="gc-filters" method="get" asp-action="Index" role="search" data-busy-form>
    <div class="gc-filters__field gc-filters__field--wide">
        <label class="gc-filters__label" for="search">Search by country or name</label>
        <input class="gc-input" id="search" name="search" type="search" value="@Model.Search" />
    </div>
    <div class="gc-filters__field">
        <label class="gc-filters__label" for="status">Status</label>
        <select class="gc-select" id="status" name="status">
            <option value="">All</option>
            @foreach (var status in Enum.GetValues<GameStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@(status == GameStatus.InProgress ? "In progress" : status.ToString())</option>
            }
        </select>
    </div>
    <div class="gc-filters__field">
        <label class="gc-filters__label" for="sort">Sort by</label>
        <select class="gc-select" id="sort" name="sort">
            @foreach (var sort in Enum.GetValues<CampaignSort>())
            {
                <option value="@sort" selected="@(Model.Sort == sort)">@(sort == CampaignSort.LastPlayed ? "Last played" : sort.ToString())</option>
            }
        </select>
    </div>
    <button class="gc-button gc-button--light" type="submit" data-busy-text="Applying">Apply</button>
</form>

@if (Model.Campaigns.Count == 0)
{
    <partial name="_EmptyState" model="@(isFiltered
        ? new EmptyStateViewModel("No campaigns match", "Nothing fits that search and status. Clear the filters to see all your campaigns.", "Clear the filters", Url.Action("Index", "Games")!)
        : new EmptyStateViewModel("No campaigns yet", "You have not started a game. Pick a country to command and the nine NPC rivals are chosen for you.", "Start your first campaign", Url.Action("New", "Games")!))" />
}
else
{
    <h2 class="gc-visually-hidden">Your campaigns</h2>
    <ul class="gc-grid">
        @foreach (var campaign in Model.Campaigns)
        {
            <partial name="_ListCard" model="@(new ListCardViewModel(
                $"Round {campaign.Round}",
                campaign.CountryCode,
                campaign.CountryName,
                [$"Status: {campaign.StatusLabel}", $"Last played {campaign.LastPlayed:d MMM yyyy, HH:mm} UTC"],
                campaign.IsInProgress ? null : campaign.StatusLabel,
                "Countries held, of 10",
                campaign.CountriesOwned.ToString(),
                campaign.IsInProgress ? "Resume" : "View",
                $"{campaign.CountryName} campaign",
                Url.Action("Play", "Games", new { id = campaign.GameId })!))" />
        }
    </ul>
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/lists.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/form-busy.js" asp-append-version="true"></script>
}
