@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<h1>Register</h1>

<form method="post" asp-action="Register">
    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <div>
        <label asp-for="DisplayName"></label>
        <input asp-for="DisplayName" autocomplete="nickname" />
        <span asp-validation-for="DisplayName"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="username" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" aria-describedby="password-rules" />
        <p id="password-rules">At least 8 characters, with an uppercase letter, a lowercase letter and a digit.</p>
        <span asp-validation-for="Password"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit">Create account</button>
</form>

<p>Already registered? <a asp-action="Login">Log in</a>.</p>
