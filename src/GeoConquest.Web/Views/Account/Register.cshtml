@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    bool Invalid(string key) => ViewData.ModelState[key]?.Errors.Count > 0;
}

<div class="gc-auth">
    <div class="gc-page-head">
        <h1 class="gc-heading gc-heading--title gc-page-head__title">Create an account</h1>
    </div>

    <form class="gc-panel gc-form" method="post" asp-action="Register" data-busy-form>
        <div asp-validation-summary="ModelOnly" role="alert"></div>

        <div class="gc-field">
            <label class="gc-label" asp-for="DisplayName"></label>
            <input class="gc-input" asp-for="DisplayName" autocomplete="nickname" required minlength="2" maxlength="30"
                   aria-describedby="DisplayName-error" aria-invalid="@(Invalid("DisplayName") ? "true" : null)" />
            <span class="gc-field__error" id="DisplayName-error" asp-validation-for="DisplayName"></span>
        </div>

        <div class="gc-field">
            <label class="gc-label" asp-for="Email"></label>
            <input class="gc-input" asp-for="Email" type="email" autocomplete="username" required maxlength="254"
                   aria-describedby="Email-error" aria-invalid="@(Invalid("Email") ? "true" : null)" />
            <span class="gc-field__error" id="Email-error" asp-validation-for="Email"></span>
        </div>

        <p class="gc-hint gc-hint--rules" id="password-rules">Password rules: at least 8 characters, with an uppercase letter, a lowercase letter and a digit.</p>

        <div class="gc-field">
            <label class="gc-label" asp-for="Password"></label>
            <input class="gc-input" asp-for="Password" autocomplete="new-password" required minlength="8" maxlength="100"
                   aria-describedby="password-rules Password-error" aria-invalid="@(Invalid("Password") ? "true" : null)" />
            <span class="gc-field__error" id="Password-error" asp-validation-for="Password"></span>
        </div>

        <div class="gc-field">
            <label class="gc-label" asp-for="ConfirmPassword"></label>
            <input class="gc-input" asp-for="ConfirmPassword" autocomplete="new-password" required
                   aria-describedby="ConfirmPassword-error" aria-invalid="@(Invalid("ConfirmPassword") ? "true" : null)" />
            <span class="gc-field__error" id="ConfirmPassword-error" asp-validation-for="ConfirmPassword"></span>
        </div>

        <button class="gc-button" type="submit" data-busy-text="Creating account">Create account</button>
    </form>

    <p>Already registered? <a asp-action="Login">Log in</a>.</p>
</div>

@section Head {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/form-busy.js" asp-append-version="true"></script>
}
