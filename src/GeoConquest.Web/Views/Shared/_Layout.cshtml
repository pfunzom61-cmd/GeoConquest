<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GeoConquest</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header>
        <a asp-controller="Home" asp-action="Index">GeoConquest</a>
        <nav aria-label="Main">
            <a asp-controller="LiveGames" asp-action="Index">Live games</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Games" asp-action="Index">My campaigns</a>
                <a asp-controller="Games" asp-action="New">New campaign</a>
                <a asp-controller="Account" asp-action="Profile">Profile</a>
                <form method="post" asp-controller="Account" asp-action="Logout">
                    <button type="submit">Log out</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Log in</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            }
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
